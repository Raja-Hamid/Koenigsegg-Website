# Copy to `.env` and fill in to make the contact form actually send.
#
# Any endpoint that accepts a multipart POST and returns 2xx works —
# Formspree (https://formspree.io/f/xxxxxxx), Web3Forms, Basin, a Netlify
# function, your own handler. Leave it unset and the form runs in demo mode:
# it still validates fully and shows real pending / success / error states,
# but says plainly that nothing was sent.
PUBLIC_CONTACT_ENDPOINT=
