---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

/**
 * The one hero.
 *
 * The old build had four different hero implementations, and both the home
 * and collection heroes pinned an absolutely-positioned stats panel to a
 * viewport corner — which landed on top of the copy and the CTAs below
 * 1200px, and completely covered the <h1> on the collection page at 390px.
 *
 * Here the stats band is a real grid item. It sits beside the copy on wide
 * screens and flows underneath it on narrow ones. It cannot overlap anything.
 */
interface Props {
  eyebrow?: string;
  title: string;
  titleAccent?: string;
  lede?: string;
  image: ImageMetadata;
  imageAlt: string;
  /** Eager + high priority when this is the LCP image (it usually is). */
  priority?: boolean;
  size?: 'full' | 'compact';
  align?: 'start' | 'center';
  scrollCue?: boolean;
}

const {
  eyebrow,
  title,
  titleAccent,
  lede,
  image,
  imageAlt,
  priority = true,
  size = 'full',
  align = 'start',
  scrollCue = false,
} = Astro.props;
---

<header class={`hero hero--${size} hero--${align}`}>
  <div class="hero__media">
    <Image
      src={image}
      alt={imageAlt}
      widths={[640, 960, 1280, 1920, 2560]}
      sizes="100vw"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding={priority ? 'sync' : 'async'}
    />
  </div>

  <div class="hero__inner">
    <div class="hero__copy">
      {eyebrow && <p class="hero__eyebrow">{eyebrow}</p>}
      <h1>
        {title}
        {titleAccent && <><br /><span class="gold-text">{titleAccent}</span></>}
      </h1>
      {lede && <p class="hero__lede">{lede}</p>}
      {Astro.slots.has('actions') && <div class="hero__actions"><slot name="actions" /></div>}
    </div>

    {Astro.slots.has('aside') && <div class="hero__aside"><slot name="aside" /></div>}
  </div>

  {
    scrollCue && (
      <a class="scroll-cue" href="#main-content" aria-label="Scroll to content">
        <Icon name="mouse" size={26} />
      </a>
    )
  }
</header>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    isolation: isolate;
    /* svh, not vh — 100vh is taller than the visible area on mobile
       browsers with dynamic toolbars, which pushed content off-screen. */
    padding: calc(var(--space-4xl) + 2rem) var(--gutter) var(--space-3xl);
  }

  .hero--full {
    min-height: 100svh;
  }
  .hero--compact {
    min-height: 62svh;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--scrim);
  }

  /* A centred headline sits mid-frame, which is exactly where the default
     scrim is lightest. Deepen the middle only for that variant. */
  .hero--center .hero__media::after {
    background:
      radial-gradient(ellipse 70% 55% at 50% 45%, rgb(0 0 0 / 0.72), transparent 70%),
      var(--scrim);
  }

  .hero__inner {
    width: 100%;
    max-width: var(--container);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-2xl);
  }

  .hero--center .hero__inner {
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    /* Wide enough that button labels never wrap mid-phrase; the headline
       gets its own tighter measure below. */
    max-width: min(100%, 36rem);
  }

  .hero--center .hero__copy {
    align-items: center;
    max-width: min(100%, 44rem);
  }

  .hero__eyebrow {
    font-size: var(--fs-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    /* Gold on unknown photography measured ~2:1. An opaque ground makes the
       ratio deterministic regardless of what is behind the hero. */
    color: var(--gold-light);
    background: rgb(5 5 5 / 0.82);
    backdrop-filter: blur(6px);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-xs);
    padding: var(--space-2xs) var(--space-sm);
  }

  .hero h1 {
    font-size: var(--fs-display);
    line-height: var(--lh-tight);
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.75);
    /* Deliberate two-to-three line wrap for the display type. */
    max-width: 12ch;
  }

  .hero--center h1 {
    max-width: 16ch;
  }

  .hero__lede {
    font-size: var(--fs-md);
    line-height: var(--lh-relaxed);
    color: var(--grey-100);
    max-width: 42ch;
    /* Guaranteed legibility over photography regardless of the crop. */
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.85);
  }

  .hero--center .hero__lede {
    max-width: 52ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-2xs);
  }

  .hero__aside {
    justify-self: end;
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: var(--space-md);
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--gold);
    animation: cue 2.4s var(--ease-smooth) infinite;
  }

  @keyframes cue {
    0%, 100% { translate: -50% 0; opacity: 0.55; }
    50% { translate: -50% 8px; opacity: 1; }
  }

  @media (max-width: 1024px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: var(--space-xl);
    }
    .hero__copy {
      max-width: 30ch;
    }
    .hero__aside {
      justify-self: stretch;
    }
  }

  @media (max-width: 640px) {
    .hero--full {
      /* Room for the band underneath without a 100svh squeeze. */
      min-height: auto;
      padding-top: calc(var(--space-4xl) + 1rem);
    }
    .scroll-cue {
      display: none;
    }
  }
</style>
