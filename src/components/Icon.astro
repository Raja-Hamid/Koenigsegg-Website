---
/**
 * Inline SVG icons.
 *
 * Replaces the Font Awesome CDN, which cost a render-blocking request and an
 * SRI hash duplicated across four files in order to draw about a dozen glyphs.
 * Decorative by default; pass a `label` to expose one to assistive tech.
 */
interface Props {
  name: keyof typeof paths;
  size?: number | string;
  label?: string;
  class?: string;
}

const paths = {
  'arrow-right': 'M5 12h14M13 6l6 6-6 6',
  'arrow-left': 'M19 12H5M11 18l-6-6 6-6',
  'chevron-down': 'M6 9l6 6 6-6',
  diamond: 'M12 3l9 9-9 9-9-9 9-9z',
  'map-pin': 'M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0z|M12 10.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z',
  envelope: 'M3 6.5h18v11H3z|M3 7l9 6.5L21 7',
  clock: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z|M12 7.5V12l3 2',
  mouse: 'M12 22a6 6 0 0 1-6-6V8a6 6 0 0 1 12 0v8a6 6 0 0 1-6 6z|M12 6.5v3',
  github:
    'M9 19c-5 1.5-5-2.5-7-3m14 6v-3.9a3.4 3.4 0 0 0-1-2.6c3.1-.3 6.4-1.5 6.4-7A5.4 5.4 0 0 0 20 4.8a5 5 0 0 0-.1-3.7s-1.1-.3-3.7 1.4a12.6 12.6 0 0 0-6.6 0C7 .8 5.9 1.1 5.9 1.1A5 5 0 0 0 5.8 4.8 5.4 5.4 0 0 0 4.3 8.6c0 5.4 3.3 6.6 6.4 7a3.4 3.4 0 0 0-1 2.6V22',
  linkedin:
    'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5z|M3 9h4v12H3z|M10 9h3.8v1.7a4.2 4.2 0 0 1 3.7-2c4 0 4.5 2.5 4.5 5.9V21h-4v-5.6c0-1.4 0-3.1-1.9-3.1s-2.2 1.5-2.2 3V21h-4z',
  x: 'M17.5 3h3.2l-7 8 8.2 10h-6.4l-5-6.1L4.8 21H1.6l7.5-8.6L1.2 3h6.6l4.5 5.6zm-1.1 16h1.8L7.7 4.8H5.8z',
  gear: 'M12 15.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4z|M19.4 15a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-1.8-.3 1.6 1.6 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1A1.6 1.6 0 0 0 9 19.4a1.6 1.6 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.6 1.6 0 0 0 .3-1.8 1.6 1.6 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1A1.6 1.6 0 0 0 4.6 9a1.6 1.6 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.6 1.6 0 0 0 1.8.3H9a1.6 1.6 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.6 1.6 0 0 0 1 1.5 1.6 1.6 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0-.3 1.8V9a1.6 1.6 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.6 1.6 0 0 0-1.5 1z',
  gauge: 'M12 21a9 9 0 1 1 0-18 9 9 0 0 1 0 18z|M12 12l4.5-4.5|M12 12h.01',
  bolt: 'M13 2L4.5 13.5H11l-1 8.5 8.5-11.5H12z',
  check: 'M4 12.5l5 5L20 6.5',
  alert: 'M12 8v5|M12 16.5v.5|M12 3l9.5 17h-19z',
  spinner: 'M12 3a9 9 0 1 0 9 9',
} as const;

const { name, size = 20, label, class: className = '' } = Astro.props;
const d = paths[name];
const segments = d.split('|');
const filled = name === 'x' || name === 'github' || name === 'linkedin';
---

<svg
  class={`icon ${className}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {label && <title>{label}</title>}
  {segments.map((seg) => <path d={seg} />)}
</svg>

<style>
  .icon {
    flex: none;
  }
</style>
