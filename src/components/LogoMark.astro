---
/**
 * The site's own mark — an original geometric K monogram in a hexagon.
 *
 * This deliberately does NOT use Koenigsegg's registered shield logo. Shipping
 * the real trademark as this site's own identity is what made the previous
 * version read as an impersonation rather than a tribute. This mark is the
 * author's, drawn for the concept build.
 *
 * Inline SVG so it is crisp at every size, needs no image request, and inherits
 * the gold gradient from the token layer.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 44, class: className = '' } = Astro.props;
---

<svg
  class={`logo-mark ${className}`}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  role="img"
  aria-label="Koenigsegg concept"
>
  <path d="M24 3 L41 13 V35 L24 45 L7 35 V13 Z" stroke-width="1.5"></path>
  <path
    d="M18 14 V34 M18 24 L30 14 M18 24 L30 34"
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
</svg>

<style>
  /* Flat gold from the token layer — no <defs>/gradient, so two instances on a
     page (nav + footer) cannot collide on a shared SVG id. */
  .logo-mark {
    display: block;
    flex: none;
    stroke: var(--gold);
  }
</style>
